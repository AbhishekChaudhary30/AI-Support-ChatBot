# ==============================================================================
# AI CUSTOMER SUPPORT CHATBOT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# NOTE: Copy this file to '.env' for local development overrides.
# NEVER commit real credentials, production secrets, or API keys into Git.
# Cloud provider API keys can also be supplied at runtime in the UI per session.
# ==============================================================================

# Application Meta & Environment
APP_NAME="AI Customer Support Chatbot"
APP_ENV=development
LOG_LEVEL=INFO
DEBUG=false

# Default Inference Provider ("ollama" or "openai_compatible")
DEFAULT_PROVIDER=ollama

# Local Ollama Configuration (Default zero-cost inference)
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_OLLAMA_MODEL=llama3.2:latest

# Request & Security Limits
REQUEST_TIMEOUT_SECONDS=60
MAX_MESSAGE_LENGTH=3000

# Social Profiles (Displayed in footer - leave empty or provide real profile links)
USER_LINKEDIN_URL=
USER_GITHUB_URL=

# Knowledge Base & Retrieval (Pre-configured for Phase 2)
KNOWLEDGE_BASE_DIR=knowledge_base
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL_NAME=nomic-embed-text
